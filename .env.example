# =============================================================================
# Exagic AI — environment template
#
# Copy to `.env` and fill in. NEVER commit the filled-in file — `.gitignore`
# excludes `.env*` and allows only this template through.
#
# On the VPS the real `.env` lives at /home/exagic.ai/public_html/.env. It is
# untracked, so the deploy's `git reset --hard origin/main` leaves it alone.
#
# Verify a deployment with:  npm run check:env
# =============================================================================


# --- Email (REQUIRED) --------------------------------------------------------
# Without all three of HOST/USER/PASSWORD every contact form, comment,
# sprint request and meeting booking fails with "Email service is not
# configured." Nothing is queued or retried — the submission is simply lost.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# 465 = implicit TLS (the code sets secure:true automatically for 465).
# 587 = STARTTLS. Defaults to 465 when unset.
SMTP_PORT=465

# Display name on outgoing mail. Defaults to "Exagic AI".
MAIL_FROM_NAME=Exagic AI

# Where form submissions are delivered. Falls back to SMTP_USER when unset.
CONTACT_RECIPIENT_EMAIL=

# Certificate validation for the SMTP connection.
# Currently defaults to "false" (validation OFF) to tolerate the self-signed
# certificates common on CyberPanel/OpenLiteSpeed hosts. That is a
# man-in-the-middle risk: set this to "true" if your mail host presents a
# valid certificate, and confirm mail still sends.
SMTP_TLS_REJECT_UNAUTHORIZED=false


# --- reCAPTCHA v3 (REQUIRED in production) -----------------------------------
# Both must be set or every form submission is rejected with
# "Server misconfiguration". Validation is bypassed entirely when
# NODE_ENV=development.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=


# --- Meeting scheduler -------------------------------------------------------
# Bearer token guarding /api/meeting/admin, used to list bookings and to
# re-open a slot after a meeting is cancelled or completed.
#
# Until this is set the admin route refuses EVERY request with 503 — an unset
# secret never means "no auth required". Booking itself still works without it;
# you simply cannot release slots.
#
# Generate one with:  openssl rand -hex 32
MEETING_ADMIN_TOKEN=

# Where booked slots are stored. Defaults to the relative path
# `.data/bookings.json`, resolved against the app's working directory.
#
# Strongly recommended in production: use an ABSOLUTE path OUTSIDE the repo so
# no git operation during deploy can ever remove it.
#   BOOKINGS_FILE=/home/exagic.ai/data/bookings.json
BOOKINGS_FILE=


# --- Calendly (OPTIONAL — read the warning) ----------------------------------
# ⚠ Setting this REPLACES the entire built-in scheduler with a Calendly embed.
#   The custom slot picker, availability endpoint and slot-blocking are all
#   bypassed while it is set. Leave it EMPTY to use the built-in scheduler.
NEXT_PUBLIC_CALENDLY_URL=
